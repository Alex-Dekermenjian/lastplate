# Local settings for the web frontend only. Copy to .env in this folder,
# or run: .\.venv\Scripts\python.exe scripts\init_dev_env.py
# Its database stores server-side sessions only (no domain data).
DB_NAME=lastplate_web
DB_USER=lastplate_web
DB_PASSWORD='replace-with-this-services-database-password'
DB_HOST=127.0.0.1
DB_PORT=55432
DJANGO_SECRET_KEY=replace-with-a-generated-local-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
HEALTH_EXPOSE_DETAILS=True
ACCOUNTS_SERVICE_URL=http://127.0.0.1:8001
MARKETPLACE_SERVICE_URL=http://127.0.0.1:8002
RESERVATIONS_SERVICE_URL=http://127.0.0.1:8003
# Runs on http://127.0.0.1:8000/
