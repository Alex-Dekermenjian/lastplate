# Local settings for the Accounts service only. Copy to .env in this folder,
# or run: .\.venv\Scripts\python.exe scripts\init_dev_env.py
# Defaults below match the Docker Compose PostgreSQL on 127.0.0.1:55432.
DB_NAME=lastplate_accounts
DB_USER=lastplate_accounts
DB_PASSWORD='replace-with-this-services-database-password'
DB_HOST=127.0.0.1
DB_PORT=55432
DJANGO_SECRET_KEY=replace-with-a-generated-local-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
HEALTH_EXPOSE_DETAILS=True
# RS256 token keys are files, not values here. scripts/init_dev_env.py creates
# them in the repository-root .keys/ folder (git-ignored). Override if needed:
# JWT_PRIVATE_KEY_FILE=C:/path/outside/the/repository/jwt-private.pem
# JWT_PUBLIC_KEY_FILE=C:/path/outside/the/repository/jwt-public.pem
# Runs on http://127.0.0.1:8001/
