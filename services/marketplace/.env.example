# Local settings for the Marketplace service only. Copy to .env in this folder,
# or run: .\.venv\Scripts\python.exe scripts\init_dev_env.py
# Defaults below match the Docker Compose PostgreSQL on 127.0.0.1:55432.
DB_NAME=lastplate_marketplace
DB_USER=lastplate_marketplace
DB_PASSWORD='replace-with-this-services-database-password'
DB_HOST=127.0.0.1
DB_PORT=55432
DJANGO_SECRET_KEY=replace-with-a-generated-local-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
HEALTH_EXPOSE_DETAILS=True
# Accounts' RS256 public key (never the private key). scripts/init_dev_env.py
# creates it at the repository-root .keys/jwt-public.pem. Override if needed:
# JWT_PUBLIC_KEY_FILE=C:/path/to/jwt-public.pem
# Runs on http://127.0.0.1:8002/
